{
  "manifest_version": 3,
  "name": "MoneyForward 総資産カレンダー",
  "version": "1.0.0",
  "description": "Chrome 起動時に MoneyForward ME の総資産を読み取り、Google カレンダーに終日予定として記録します。",
  "key": "",
  "permissions": [
    "identity.email",
    "identity",
    "scripting",
    "notifications",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://moneyforward.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "総資産を今すぐカレンダーに記録"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "365680201950-kaom0amh42uctcdh4vbs9ot4ok3p4a59.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events"
    ]
  }
}
